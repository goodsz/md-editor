{
  "name": "md-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm:build": "cargo build --manifest-path wasm/md-kernel/Cargo.toml --release --target wasm32-unknown-unknown && node scripts/copy-kernel.mjs && node scripts/verify-kernel.mjs",
    "electron": "electron .",
    "electron:dev": "concurrently -k -s first \"npm:dev\" \"npm:electron\"",
    "electron:smoke": "npm run build && electron . --smoke",
    "electron:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.mdeditor.app",
    "productName": "md-editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
